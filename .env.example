# Get this from @BotFather on Telegram
BOT_TOKEN=

# Free key from https://finnhub.io (sign up, no credit card) — powers /news and /calendar
FINNHUB_API_KEY=

# How often (minutes) to check for fresh news and push to subscribers. Default 240 (4h).
NOTIFY_INTERVAL_MINUTES=240

# Optional: point at a Railway Volume mount path so subscriber lists survive
# redeploys, e.g. /data. Defaults to local disk (resets on redeploy).
DATA_DIR=
